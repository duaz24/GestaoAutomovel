<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/txtDetalheTitulo" android:textSize="24sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Viatura"/>

    <TextView android:id="@+id/txtMediaConsumo" android:text="Média: -- L/100km" android:textSize="20sp" android:textColor="#4CAF50" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold"/>

    <Button android:id="@+id/btnAddGasto" android:text="Registar Gasto / Abastecimento" android:layout_marginTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:text="Histórico de Despesas" android:layout_marginTop="25dp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp"/>

    <ListView android:id="@+id/listHistorico" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp"/>
</LinearLayout>