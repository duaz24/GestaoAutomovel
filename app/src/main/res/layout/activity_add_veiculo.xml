<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova Viatura"
            android:textColor="@color/brand_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Preencha os dados para começar a gerir os custos."
            android:textColor="@color/brand_text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/brand_secondary"
            android:hint="Marca (ex: Toyota)"
            android:inputType="textCapSentences"
            android:minHeight="56dp"
            android:padding="14dp" />

        <EditText
            android:id="@+id/editModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/brand_secondary"
            android:hint="Modelo (ex: Yaris)"
            android:inputType="textCapSentences"
            android:minHeight="56dp"
            android:padding="14dp" />

        <EditText
            android:id="@+id/editMatricula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/brand_secondary"
            android:hint="Matrícula"
            android:inputType="textCapCharacters"
            android:minHeight="56dp"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnGuardarVeiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/brand_primary"
            android:text="Guardar Viatura"
            android:textColor="@color/white" />
    </LinearLayout>

</ScrollView>
